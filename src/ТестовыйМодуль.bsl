////////////////////////////////////////////////////////////////////////////////
// Тестовый модуль для проверки настройки Git и VS Code на проектах 1С.
//
// Что демонстрирует:
//   - кириллицу в исходниках (UTF-8 с BOM, CRLF) и корректный diff в репозитории;
//   - работу с коллекциями платформы: Массив, Соответствие, ТаблицаЗначений;
//   - самопроверку: функция ВыполнитьСамопроверку() возвращает результат,
//     не обращаясь к информационной базе и не изменяя данные.
//
// Модуль серверный: подключается как общий модуль (Сервер = Истина)
// либо вызывается из внешней обработки.
////////////////////////////////////////////////////////////////////////////////

// Возвращает версию модуля. Нужна, чтобы в истории коммитов был виден прогресс.
//
// Возвращаемое значение:
//  Строка - версия модуля в формате "Основная.Дополнительная.Правка".
Функция ВерсияМодуля() Экспорт
	
	Возврат "1.1.0";
	
КонецФункции

// Возвращает приветствие для указанного имени пользователя.
//
// Параметры:
//  ИмяПользователя - Строка - имя, которое подставляется в приветствие.
//
// Возвращаемое значение:
//  Строка - текст приветствия.
Функция Приветствие(ИмяПользователя) Экспорт
	
	Если Не ЗначениеЗаполнено(ИмяПользователя) Тогда
		Возврат "Привет! Имя пользователя не указано.";
	КонецЕсли;
	
	Возврат СтрШаблон("Привет, %1! Тестовый модуль версии %2 на связи.",
		СокрЛП(ИмяПользователя), ВерсияМодуля());
	
КонецФункции

// Считает сумму квадратов чисел массива. Нечисловые элементы пропускаются.
//
// Параметры:
//  Значения - Массив - произвольный набор значений.
//
// Возвращаемое значение:
//  Число - сумма квадратов числовых элементов.
Функция СуммаКвадратов(Значения) Экспорт
	
	Если ТипЗнч(Значения) <> Тип("Массив") Тогда
		ВызватьИсключение "Ожидался массив чисел.";
	КонецЕсли;
	
	Результат = 0;
	Для Каждого Элемент Из Значения Цикл
		Если ТипЗнч(Элемент) = Тип("Число") Тогда
			Результат = Результат + Элемент * Элемент;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Формирует демонстрационную таблицу показателей.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: Показатель (Строка), Значение (Число).
Функция ТаблицаПоказателей() Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Показатель",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Значение",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	
	Данные = Новый Соответствие;
	Данные.Вставить("Выручка", 125000.5);
	Данные.Вставить("Себестоимость", 98000);
	Данные.Вставить("Прибыль", 27000.5);
	
	Для Каждого Пара Из Данные Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Показатель = Пара.Ключ;
		СтрокаТаблицы.Значение = Пара.Значение;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

// Превращает таблицу показателей в многострочный текст.
//
// Параметры:
//  Таблица - ТаблицаЗначений - таблица с колонками Показатель и Значение.
//
// Возвращаемое значение:
//  Строка - текст отчёта, по одной строке на показатель.
Функция ОписаниеТаблицы(Таблица) Экспорт
	
	Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение "Ожидалась таблица значений.";
	КонецЕсли;
	
	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Строки.Добавить(СтрШаблон("%1: %2", СтрокаТаблицы.Показатель,
			Формат(СтрокаТаблицы.Значение, "ЧДЦ=2; ЧН=0,00")));
	КонецЦикла;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Сравнивает ожидаемое и фактическое значения, дописывает строку в отчёт.
//
// Параметры:
//  Строки       - Массив - накопитель строк отчёта, изменяется.
//  ИмяПроверки  - Строка - название проверки для отчёта.
//  Ожидание     - Произвольный - эталонное значение.
//  Факт         - Произвольный - полученное значение.
//
// Возвращаемое значение:
//  Число - 0, если проверка пройдена, иначе 1.
Функция ЗаписатьПроверку(Строки, ИмяПроверки, Ожидание, Факт)
	
	Если Ожидание = Факт Тогда
		Строки.Добавить(СтрШаблон("[OK]   %1 = %2", ИмяПроверки, Представление(Факт)));
		Возврат 0;
	КонецЕсли;
	
	Строки.Добавить(СтрШаблон("[FAIL] %1: ожидалось <%2>, получено <%3>",
		ИмяПроверки, Представление(Ожидание), Представление(Факт)));
	
	Возврат 1;
	
КонецФункции

// Выполняет самопроверку модуля. Данные базы не читает и не изменяет.
//
// Возвращаемое значение:
//  Структура:
//   * Успешно  - Булево - Истина, если все проверки прошли;
//   * Проверок - Число  - количество выполненных проверок;
//   * Ошибок   - Число  - количество проваленных проверок;
//   * Отчёт    - Строка - построчный результат проверок.
Функция ВыполнитьСамопроверку() Экспорт
	
	Строки = Новый Массив;
	Проверок = 0;
	Ошибок = 0;
	
	// 1. Приветствие подставляет имя пользователя и версию модуля.
	Ошибок = Ошибок + ЗаписатьПроверку(Строки, "Приветствие с именем",
		СтрШаблон("Привет, Сергей! Тестовый модуль версии %1 на связи.", ВерсияМодуля()),
		Приветствие("Сергей"));
	Проверок = Проверок + 1;
	
	// 2. Пустое имя обрабатывается отдельным сообщением.
	Ошибок = Ошибок + ЗаписатьПроверку(Строки, "Приветствие без имени",
		"Привет! Имя пользователя не указано.", Приветствие(""));
	Проверок = Проверок + 1;
	
	// 3. Сумма квадратов: 1*1 + 2*2 + 3*3 = 14.
	Числа = Новый Массив;
	Числа.Добавить(1);
	Числа.Добавить(2);
	Числа.Добавить(3);
	Ошибок = Ошибок + ЗаписатьПроверку(Строки, "Сумма квадратов", 14, СуммаКвадратов(Числа));
	Проверок = Проверок + 1;
	
	// 4. Нечисловые элементы массива пропускаются: 2*2 + 3*3 = 13.
	СмешанныйМассив = Новый Массив;
	СмешанныйМассив.Добавить(2);
	СмешанныйМассив.Добавить("текст");
	СмешанныйМассив.Добавить(3);
	Ошибок = Ошибок + ЗаписатьПроверку(Строки, "Нечисловые элементы пропущены",
		13, СуммаКвадратов(СмешанныйМассив));
	Проверок = Проверок + 1;
	
	// 5. Кириллица читается как символы, а не как байты.
	Ошибок = Ошибок + ЗаписатьПроверку(Строки, "Длина кириллической строки", 8, СтрДлина("Проверка"));
	Проверок = Проверок + 1;
	
	// 6. В демонстрационной таблице три строки.
	Таблица = ТаблицаПоказателей();
	Ошибок = Ошибок + ЗаписатьПроверку(Строки, "Количество показателей", 3, Таблица.Количество());
	Проверок = Проверок + 1;
	
	// 7. Описание таблицы содержит строку на каждый показатель.
	Описание = ОписаниеТаблицы(Таблица);
	Ошибок = Ошибок + ЗаписатьПроверку(Строки, "Строк в описании таблицы", 3,
		СтрРазделить(Описание, Символы.ПС, Ложь).Количество());
	Проверок = Проверок + 1;
	
	// 8. Первая строка описания начинается с названия показателя.
	ПерваяСтрока = СтрПолучитьСтроку(Описание, 1);
	Ошибок = Ошибок + ЗаписатьПроверку(Строки, "Первая строка описания",
		Истина, СтрНачинаетсяС(ПерваяСтрока, "Выручка: "));
	Проверок = Проверок + 1;
	
	Возврат Новый Структура("Успешно, Проверок, Ошибок, Отчёт",
		Ошибок = 0, Проверок, Ошибок, СтрСоединить(Строки, Символы.ПС));
	
КонецФункции

// Выполняет самопроверку и записывает отчёт в текстовый файл (UTF-8).
//
// Параметры:
//  ПутьФайла - Строка - полный путь к файлу отчёта.
//
// Возвращаемое значение:
//  Булево - Истина, если все проверки прошли.
Функция ЗаписатьОтчётВФайл(ПутьФайла) Экспорт
	
	Результат = ВыполнитьСамопроверку();
	
	Запись = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8);
	Попытка
		Запись.ЗаписатьСтроку("Тестовый модуль, версия " + ВерсияМодуля());
		Запись.ЗаписатьСтроку(СтрШаблон("Проверок: %1, ошибок: %2", Результат.Проверок, Результат.Ошибок));
		Запись.ЗаписатьСтроку(Результат.Отчёт);
	Исключение
		Запись.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Запись.Закрыть();
	
	Возврат Результат.Успешно;
	
КонецФункции
